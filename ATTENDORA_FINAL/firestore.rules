rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'owner@attendora.com' ||
        (userExists() && getUserData().get('isSuperAdmin', false) == true)
      );
    }

    function isInstitutionAdmin(instCode) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userExists() && 
         (getUserData().get('admin', false) == true || getUserData().get('role', '') == 'admin') &&
         getUserData().get('institutionCode', '') == instCode)
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userExists() && (
          getUserData().get('role', '') == 'teacher' ||
          getUserData().get('teacher', false) == true
        ))
      );
    }

    // ===============================================================
    // Institutions
    // ===============================================================
    match /institutions/{institutionId} {
      // Public read required for institution selection and domain verification during onboarding
      allow read: if true;
      // Only Super Admin can create, modify, or delete institutions
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{userId} {
      // Allow reading user profiles if authenticated or looking up login accounts
      allow read: if true;
      
      // Creating user document on signup
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
      );

      // Updating user document
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isInstitutionAdmin(resource.data.get('institutionCode', ''))
      );

      // Deleting user document
      allow delete: if isSuperAdmin();
    }

    // Index for ensuring unique Roll/ID numbers atomically
    match /id_index/{indexId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ===============================================================
    // Attendance Sessions & Records
    // ===============================================================
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      
      // Teachers and Admins can create sessions
      allow create: if isAuthenticated() && (
        isTeacher() ||
        isSuperAdmin() ||
        request.resource.data.get('teacherUid', '') == request.auth.uid
      );
      
      // Session owners and Admins can update/close sessions
      allow update: if isAuthenticated() && (
        resource.data.get('teacherUid', '') == request.auth.uid ||
        isSuperAdmin() ||
        isInstitutionAdmin(resource.data.get('institutionCode', ''))
      );

      allow delete: if isAuthenticated() && (
        resource.data.get('teacherUid', '') == request.auth.uid ||
        isSuperAdmin()
      );

      // Attendance Subcollection for Students
      match /attendance/{studentUid} {
        allow read: if isAuthenticated() && (
          request.auth.uid == studentUid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('teacherUid', '') == request.auth.uid ||
          isSuperAdmin()
        );

        // Students may create their own present record only while the session
        // is active. The immutable identity fields and distance are validated
        // server-side so a modified client cannot spoof another student.
        allow create: if isAuthenticated() && (
          (
            request.auth.uid == studentUid &&
            request.resource.data.get('uid', '') == request.auth.uid &&
            request.resource.data.get('sessionId', '') == sessionId &&
            request.resource.data.get('status', '') == 'present' &&
            request.resource.data.get('distanceMeters', -1) is number &&
            (
              get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('bypassLocation', false) == true ||
              request.resource.data.get('distanceMeters', -1) <=
                get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('radiusMeters', 0) + 2
            ) &&
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('active', false) == true &&
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('expiresAt', request.time) > request.time
          ) ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('teacherUid', '') == request.auth.uid ||
          isSuperAdmin()
        );

        // Students cannot overwrite an existing present record. Teachers and
        // admins may update records for manual corrections.
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('teacherUid', '') == request.auth.uid ||
          isSuperAdmin() ||
          (
            request.auth.uid == studentUid &&
            resource.data.get('status', '') != 'present' &&
            request.resource.data.get('uid', '') == request.auth.uid &&
            request.resource.data.get('sessionId', '') == sessionId &&
            request.resource.data.get('status', '') == 'present' &&
            request.resource.data.get('distanceMeters', -1) is number &&
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('active', false) == true &&
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('expiresAt', request.time) > request.time
          )
        );

        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('teacherUid', '') == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }

    // Collection group query for attendance analytics & history
    match /{path=**}/attendance/{attendanceDoc} {
      allow read: if isAuthenticated();
    }

    // ===============================================================
    // Academic Resources (Class Groups, Subjects, Schedules)
    // ===============================================================
    match /class_groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /scheduled_sessions/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===============================================================
    // Notifications & Broadcasts
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===============================================================
    // Audit Logs
    // ===============================================================
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // Faculty Geo-Attendance
    // ===============================================================
    match /geo_attendance_settings/{institutionCode} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isInstitutionAdmin(institutionCode);
    }

    match /faculty_geo_attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.get('facultyId', '') == request.auth.uid ||
        isSuperAdmin() ||
        isInstitutionAdmin(request.resource.data.get('institutionCode', ''))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isInstitutionAdmin(resource.data.get('institutionCode', '')) ||
        (
          resource.data.get('facultyId', '') == request.auth.uid &&
          request.resource.data.get('facultyId', '') == resource.data.get('facultyId', '') &&
          request.resource.data.get('institutionCode', '') == resource.data.get('institutionCode', '') &&
          request.resource.data.get('date', '') == resource.data.get('date', '')
        )
      );
      allow delete: if isSuperAdmin() ||
        isInstitutionAdmin(resource.data.get('institutionCode', ''));
    }

    // ===============================================================
    // System Settings & Health
    // ===============================================================
    match /_system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /system_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
