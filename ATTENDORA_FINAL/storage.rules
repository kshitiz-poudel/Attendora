rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Faculty verification selfies. Write is restricted to the faculty member
    // the photo is about, so nobody can plant evidence under another account.
    //
    // NOTE: read access here governs the Storage API only. Firebase
    // getDownloadURL() mints a URL carrying its own access token, and anyone
    // holding that URL can fetch the object regardless of these rules. The
    // Firestore document holding the URL is therefore the real access
    // boundary and is restricted to the faculty member and their institution
    // admins (see firestore.rules). To make the object itself private, store
    // the storage path instead of a download URL and read it through the
    // authenticated SDK.
    match /faculty_geo_attendance/{facultyId}/{date}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == facultyId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Nothing else is writable by clients.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
