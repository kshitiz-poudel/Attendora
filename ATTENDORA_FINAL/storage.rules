rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /faculty_geo_attendance/{facultyId}/{date}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == facultyId && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
